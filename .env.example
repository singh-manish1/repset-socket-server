# Server Configuration
PORT=3001

# Authentication (REQUIRED)
# Generate a strong random secret: openssl rand -base64 32
ADMIN_SECRET=your_secure_admin_secret_here

# Database Webhook Configuration (Optional but recommended)
WEBHOOK_URL=https://your-app.vercel.app/api/webhooks/biometric-events
BIOMETRIC_WEBHOOK_SECRET=your_webhook_secret_here

# Notes:
# - ADMIN_SECRET is required for all connections (bridges and admins)
# - WEBHOOK_URL is where hardware events will be sent for database logging
# - BIOMETRIC_WEBHOOK_SECRET is sent with webhook requests for authentication
# - If webhook variables are not set, events will still broadcast but won't be logged to database
